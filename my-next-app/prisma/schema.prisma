generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      String
  projects  Project[]  @relation("ProjectMembers")
  managedProjects Project[] @relation("ProjectAdmins")
  assignedTasks   BoardTask[] @relation("TaskAssignees")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String

  admin       User      @relation("ProjectAdmins", fields: [adminId], references: [id])
  adminId     Int

  members     User[]    @relation("ProjectMembers")
  boardColumns BoardColumn[]
  boardTasks   BoardTask[]
  sprints      Sprint[]        // main 分支新增
}

model BoardColumn {
  id         Int         @id @default(autoincrement())
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  name       String
  order      Int
  tasks      BoardTask[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model BoardTask {
  id          Int         @id @default(autoincrement())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  column      BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  columnId    Int?
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull) // main 分支新增
  sprintId    Int?                                              // main 分支新增
  title       String
  description String?
  tags        String[]    @default([])
  assignee    User?       @relation("TaskAssignees", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dueDate     DateTime?   // 截止时间
  estimatedHours Int?     // 预估工时（小时）
  actualHours Int?        // 实际工时（小时）
  status      String      @default("未开始") // main 分支新增
}

model Sprint {
  id          Int          @id @default(autoincrement())   // main 分支新增
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade) // main 分支新增
  projectId   Int          // main 分支新增
  name        String       // main 分支新增
  order       Int          // main 分支新增
  startDate   DateTime?    // main 分支新增
  endDate     DateTime?    // main 分支新增
  status      String       @default("未开始") // main 分支新增
  tasks       BoardTask[]  // main 分支新增

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
