generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      String
  projects  Project[]  @relation("ProjectMembers")
  managedProjects Project[] @relation("ProjectAdmins")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String

  admin       User      @relation("ProjectAdmins", fields: [adminId], references: [id])
  adminId     Int

  members     User[]    @relation("ProjectMembers")
  statuses    Status[]  @relation("ProjectStatuses")
  tasks       Task[]    @relation("ProjectTasks")
}

model Status {
  id        Int       @id @default(autoincrement())
  name      String
  project   Project   @relation("ProjectStatuses", fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  tasks     Task[]    @relation("StatusTasks")
  createdAt DateTime  @default(now())
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  tags        String[]  @default([])
  project     Project   @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  status      Status    @relation("StatusTasks", fields: [statusId], references: [id], onDelete: Cascade)
  statusId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}