generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      String
  projects  Project[]  @relation("ProjectMembers")
  managedProjects Project[] @relation("ProjectAdmins")
  assignedTasks   BoardTask[] @relation("TaskAssignees")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String

  admin       User      @relation("ProjectAdmins", fields: [adminId], references: [id])
  adminId     Int

  members     User[]    @relation("ProjectMembers")
  boardColumns BoardColumn[]
  boardTasks   BoardTask[]
}

model BoardColumn {
  id         Int         @id @default(autoincrement())
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  name       String
  order      Int
  tasks      BoardTask[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model BoardTask {
  id          Int         @id @default(autoincrement())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  column      BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  columnId    Int?
  title       String
  description String?
  tags        String[]    @default([])
  assignee    User?       @relation("TaskAssignees", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}